rules_version = '2';

// SNote data: snote_users/{uid}/{drives|folders|notes|blocks}/{id}, owner-only.
// The Firebase project is shared with other apps (e.g. games). When adding this to the
// project's existing rules, copy only the `match /snote_users/...` block into the existing
// `match /databases/{database}/documents { ... }` block and keep everything else as it is.
service cloud.firestore {
  match /databases/{database}/documents {
    match /snote_users/{uid}/{collection}/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && collection in ['drives', 'folders', 'notes', 'blocks']
        && request.resource.data.keys().hasAll(['createdAt', 'updatedAt'])
        && request.resource.size() < 900 * 1024;
    }
  }
}
