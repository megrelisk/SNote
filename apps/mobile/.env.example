# Copy to .env and fill in from your Firebase project.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.XXXXXXXX
# Optional overrides (defaults: ./google-services.json and ./GoogleService-Info.plist)
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_PLIST=
SNOTE_BUNDLE_ID=app.snote.mobile
# Apple Developer Team ID (needed to sign the widget extension)
APPLE_TEAM_ID=
