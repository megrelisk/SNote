<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/card_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/snote_widget_card"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:id="@+id/card_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="@color/snote_widget_text"
    android:textSize="17sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/card_path"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="@color/snote_widget_accent"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/card_preview"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:lineSpacingMultiplier="1.15"
    android:textColor="@color/snote_widget_text"
    android:textSize="14sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/card_updated"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textColor="@color/snote_widget_text_soft"
      android:textSize="11sp" />

    <TextView
      android:id="@+id/card_position"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@color/snote_widget_text_soft"
      android:textSize="11sp" />
  </LinearLayout>
</LinearLayout>
