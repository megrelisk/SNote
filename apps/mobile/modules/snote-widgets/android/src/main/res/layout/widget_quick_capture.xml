<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/capture_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/snote_widget_bg"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/capture_drive_chip"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:background="@drawable/snote_widget_chip"
      android:ellipsize="end"
      android:maxLines="1"
      android:paddingHorizontal="10dp"
      android:paddingVertical="6dp"
      android:text="🗂 Drive  ▾"
      android:textColor="@color/snote_widget_accent"
      android:textSize="13sp" />

    <TextView
      android:id="@+id/capture_folder_chip"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:layout_weight="1"
      android:background="@drawable/snote_widget_chip"
      android:ellipsize="end"
      android:maxLines="1"
      android:paddingHorizontal="10dp"
      android:paddingVertical="6dp"
      android:text="📁 Folder  ▾"
      android:textColor="@color/snote_widget_accent"
      android:textSize="13sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/capture_input"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:background="@drawable/snote_widget_input"
    android:gravity="top|start"
    android:minHeight="44dp"
    android:padding="12dp"
    android:text="✏️  Write a note…"
    android:textColor="@color/snote_widget_text_soft"
    android:textSize="15sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/capture_todo"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/snote_widget_chip"
      android:paddingHorizontal="12dp"
      android:paddingVertical="6dp"
      android:text="☑ To-do"
      android:textColor="@color/snote_widget_text"
      android:textSize="13sp" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/capture_open_app"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:paddingHorizontal="8dp"
      android:paddingVertical="6dp"
      android:text="SNote ↗"
      android:textColor="@color/snote_widget_text_soft"
      android:textSize="13sp" />
  </LinearLayout>
</LinearLayout>
