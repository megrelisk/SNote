<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/snote_widget_bg"
  android:orientation="vertical"
  android:padding="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/carousel_header"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:paddingHorizontal="4dp"
      android:text="SNote"
      android:textColor="@color/snote_widget_accent"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/carousel_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="3"
      android:ellipsize="end"
      android:gravity="end"
      android:maxLines="1"
      android:text="Recently modified"
      android:textColor="@color/snote_widget_text_soft"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/carousel_configure"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:paddingHorizontal="8dp"
      android:text="⚙"
      android:textColor="@color/snote_widget_text_soft"
      android:textSize="14sp" />

    <TextView
      android:id="@+id/carousel_add"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/snote_widget_chip"
      android:paddingHorizontal="10dp"
      android:paddingVertical="2dp"
      android:text="+"
      android:textColor="@color/snote_widget_accent"
      android:textSize="16sp"
      android:textStyle="bold" />
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1">

    <StackView
      android:id="@+id/carousel_stack"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:loopViews="true" />

    <TextView
      android:id="@+id/carousel_empty"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:padding="12dp"
      android:text="No notes yet — tap + to write one."
      android:textColor="@color/snote_widget_text_soft"
      android:textSize="14sp" />
  </FrameLayout>
</LinearLayout>
