<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:padding="20dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Quick note"
    android:textSize="20sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/capture_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:visibility="gone" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="horizontal">

    <Spinner
      android:id="@+id/capture_drive_spinner"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:contentDescription="Drive" />

    <Spinner
      android:id="@+id/capture_folder_spinner"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:contentDescription="Folder" />
  </LinearLayout>

  <EditText
    android:id="@+id/capture_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="top|start"
    android:hint="First line becomes the title.\n[ ] item = to-do · - item = bullet"
    android:importantForAutofill="no"
    android:inputType="textMultiLine|textCapSentences"
    android:maxLines="10"
    android:minLines="4" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:gravity="end"
    android:orientation="horizontal">

    <Button
      android:id="@+id/capture_cancel"
      style="?android:attr/borderlessButtonStyle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Cancel" />

    <Button
      android:id="@+id/capture_save"
      style="?android:attr/borderlessButtonStyle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Save"
      android:textColor="@color/snote_widget_accent"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
